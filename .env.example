# =====================================================================
# MINI CLOUD IMAGE STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to '.env' in the project root directory:
#   cp .env.example .env
#
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB / SOURCE CONTROL!
# =====================================================================

# AWS Credentials (Mock credentials for LocalStack / MinIO)
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
AWS_REGION=us-east-1

# Local Cloud Endpoint Configurations
# Option 1: MinIO (Port 9000) + DynamoDB Local (Port 8000)
S3_ENDPOINT_URL=http://localhost:9000
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Option 2: LocalStack Unified Endpoint (Port 4566)
# Uncomment lines below if using LocalStack for both S3 & DynamoDB:
# S3_ENDPOINT_URL=http://localhost:4566
# DYNAMODB_ENDPOINT_URL=http://localhost:4566

# Cloud Storage & Database Resource Names
S3_BUCKET_NAME=mini-cloud-image-studio
DYNAMODB_TABLE_NAME=MiniCloudImages
